`timescale 1ns/1ps

module axi_crossbar_2m3s_wrapper #(
    parameter int S_COUNT = 2,
    parameter int M_COUNT = 3,
    parameter int ADDR_WIDTH = 32,
    parameter int DATA_WIDTH = 32,
    parameter int STRB_WIDTH = DATA_WIDTH/8,
    parameter int S_ID_WIDTH = 4,
    parameter int M_ID_WIDTH = S_ID_WIDTH+$clog2(S_COUNT),
    parameter int USER_WIDTH = 1
) (
    input logic clk,
    input logic rst,
    axi_interface #(ADDR_WIDTH, DATA_WIDTH, S_ID_WIDTH, USER_WIDTH) s_axi_if [S_COUNT],
    axi_interface #(ADDR_WIDTH, DATA_WIDTH, M_ID_WIDTH, USER_WIDTH) m_axi_if [M_COUNT]
);
    localparam [M_COUNT*ADDR_WIDTH-1:0] M_BASE_ADDR = {
        32'h0002_0000,
        32'h0001_0000,
        32'h0000_0000
    };
    localparam [M_COUNT*32-1:0] M_ADDR_WIDTH = {M_COUNT{32'd12}};

    logic [S_COUNT*S_ID_WIDTH-1:0]    s_awid;
    logic [S_COUNT*ADDR_WIDTH-1:0]    s_awaddr;
    logic [S_COUNT*8-1:0]             s_awlen;
    logic [S_COUNT*3-1:0]             s_awsize;
    logic [S_COUNT*2-1:0]             s_awburst;
    logic [S_COUNT-1:0]               s_awlock;
    logic [S_COUNT*4-1:0]             s_awcache;
    logic [S_COUNT*3-1:0]             s_awprot;
    logic [S_COUNT*4-1:0]             s_awqos;
    logic [S_COUNT*USER_WIDTH-1:0]    s_awuser;
    logic [S_COUNT-1:0]               s_awvalid;
    logic [S_COUNT-1:0]               s_awready;
    logic [S_COUNT*DATA_WIDTH-1:0]    s_wdata;
    logic [S_COUNT*STRB_WIDTH-1:0]    s_wstrb;
    logic [S_COUNT-1:0]               s_wlast;
    logic [S_COUNT*USER_WIDTH-1:0]    s_wuser;
    logic [S_COUNT-1:0]               s_wvalid;
    logic [S_COUNT-1:0]               s_wready;
    logic [S_COUNT*S_ID_WIDTH-1:0]    s_bid;
    logic [S_COUNT*2-1:0]             s_bresp;
    logic [S_COUNT*USER_WIDTH-1:0]    s_buser;
    logic [S_COUNT-1:0]               s_bvalid;
    logic [S_COUNT-1:0]               s_bready;
    logic [S_COUNT*S_ID_WIDTH-1:0]    s_arid;
    logic [S_COUNT*ADDR_WIDTH-1:0]    s_araddr;
    logic [S_COUNT*8-1:0]             s_arlen;
    logic [S_COUNT*3-1:0]             s_arsize;
    logic [S_COUNT*2-1:0]             s_arburst;
    logic [S_COUNT-1:0]               s_arlock;
    logic [S_COUNT*4-1:0]             s_arcache;
    logic [S_COUNT*3-1:0]             s_arprot;
    logic [S_COUNT*4-1:0]             s_arqos;
    logic [S_COUNT*USER_WIDTH-1:0]    s_aruser;
    logic [S_COUNT-1:0]               s_arvalid;
    logic [S_COUNT-1:0]               s_arready;
    logic [S_COUNT*S_ID_WIDTH-1:0]    s_rid;
    logic [S_COUNT*DATA_WIDTH-1:0]    s_rdata;
    logic [S_COUNT*2-1:0]             s_rresp;
    logic [S_COUNT-1:0]               s_rlast;
    logic [S_COUNT*USER_WIDTH-1:0]    s_ruser;
    logic [S_COUNT-1:0]               s_rvalid;
    logic [S_COUNT-1:0]               s_rready;

    logic [M_COUNT*M_ID_WIDTH-1:0]    m_awid;
    logic [M_COUNT*ADDR_WIDTH-1:0]    m_awaddr;
    logic [M_COUNT*8-1:0]             m_awlen;
    logic [M_COUNT*3-1:0]             m_awsize;
    logic [M_COUNT*2-1:0]             m_awburst;
    logic [M_COUNT-1:0]               m_awlock;
    logic [M_COUNT*4-1:0]             m_awcache;
    logic [M_COUNT*3-1:0]             m_awprot;
    logic [M_COUNT*4-1:0]             m_awqos;
    logic [M_COUNT*4-1:0]             m_awregion;
    logic [M_COUNT*USER_WIDTH-1:0]    m_awuser;
    logic [M_COUNT-1:0]               m_awvalid;
    logic [M_COUNT-1:0]               m_awready;
    logic [M_COUNT*DATA_WIDTH-1:0]    m_wdata;
    logic [M_COUNT*STRB_WIDTH-1:0]    m_wstrb;
    logic [M_COUNT-1:0]               m_wlast;
    logic [M_COUNT*USER_WIDTH-1:0]    m_wuser;
    logic [M_COUNT-1:0]               m_wvalid;
    logic [M_COUNT-1:0]               m_wready;
    logic [M_COUNT*M_ID_WIDTH-1:0]    m_bid;
    logic [M_COUNT*2-1:0]             m_bresp;
    logic [M_COUNT*USER_WIDTH-1:0]    m_buser;
    logic [M_COUNT-1:0]               m_bvalid;
    logic [M_COUNT-1:0]               m_bready;
    logic [M_COUNT*M_ID_WIDTH-1:0]    m_arid;
    logic [M_COUNT*ADDR_WIDTH-1:0]    m_araddr;
    logic [M_COUNT*8-1:0]             m_arlen;
    logic [M_COUNT*3-1:0]             m_arsize;
    logic [M_COUNT*2-1:0]             m_arburst;
    logic [M_COUNT-1:0]               m_arlock;
    logic [M_COUNT*4-1:0]             m_arcache;
    logic [M_COUNT*3-1:0]             m_arprot;
    logic [M_COUNT*4-1:0]             m_arqos;
    logic [M_COUNT*4-1:0]             m_arregion;
    logic [M_COUNT*USER_WIDTH-1:0]    m_aruser;
    logic [M_COUNT-1:0]               m_arvalid;
    logic [M_COUNT-1:0]               m_arready;
    logic [M_COUNT*M_ID_WIDTH-1:0]    m_rid;
    logic [M_COUNT*DATA_WIDTH-1:0]    m_rdata;
    logic [M_COUNT*2-1:0]             m_rresp;
    logic [M_COUNT-1:0]               m_rlast;
    logic [M_COUNT*USER_WIDTH-1:0]    m_ruser;
    logic [M_COUNT-1:0]               m_rvalid;
    logic [M_COUNT-1:0]               m_rready;

    genvar i;
    generate
        for (i = 0; i < S_COUNT; i++) begin : pack_s
            assign s_awid[i*S_ID_WIDTH +: S_ID_WIDTH] = s_axi_if[i].awid;
            assign s_awaddr[i*ADDR_WIDTH +: ADDR_WIDTH] = s_axi_if[i].awaddr;
            assign s_awlen[i*8 +: 8] = s_axi_if[i].awlen;
            assign s_awsize[i*3 +: 3] = s_axi_if[i].awsize;
            assign s_awburst[i*2 +: 2] = s_axi_if[i].awburst;
            assign s_awlock[i] = s_axi_if[i].awlock;
            assign s_awcache[i*4 +: 4] = s_axi_if[i].awcache;
            assign s_awprot[i*3 +: 3] = s_axi_if[i].awprot;
            assign s_awqos[i*4 +: 4] = s_axi_if[i].awqos;
            assign s_awuser[i*USER_WIDTH +: USER_WIDTH] = s_axi_if[i].awuser;
            assign s_awvalid[i] = s_axi_if[i].awvalid;
            assign s_axi_if[i].awready = s_awready[i];
            assign s_wdata[i*DATA_WIDTH +: DATA_WIDTH] = s_axi_if[i].wdata;
            assign s_wstrb[i*STRB_WIDTH +: STRB_WIDTH] = s_axi_if[i].wstrb;
            assign s_wlast[i] = s_axi_if[i].wlast;
            assign s_wuser[i*USER_WIDTH +: USER_WIDTH] = s_axi_if[i].wuser;
            assign s_wvalid[i] = s_axi_if[i].wvalid;
            assign s_axi_if[i].wready = s_wready[i];
            assign s_axi_if[i].bid = s_bid[i*S_ID_WIDTH +: S_ID_WIDTH];
            assign s_axi_if[i].bresp = s_bresp[i*2 +: 2];
            assign s_axi_if[i].buser = s_buser[i*USER_WIDTH +: USER_WIDTH];
            assign s_axi_if[i].bvalid = s_bvalid[i];
            assign s_bready[i] = s_axi_if[i].bready;
            assign s_arid[i*S_ID_WIDTH +: S_ID_WIDTH] = s_axi_if[i].arid;
            assign s_araddr[i*ADDR_WIDTH +: ADDR_WIDTH] = s_axi_if[i].araddr;
            assign s_arlen[i*8 +: 8] = s_axi_if[i].arlen;
            assign s_arsize[i*3 +: 3] = s_axi_if[i].arsize;
            assign s_arburst[i*2 +: 2] = s_axi_if[i].arburst;
            assign s_arlock[i] = s_axi_if[i].arlock;
            assign s_arcache[i*4 +: 4] = s_axi_if[i].arcache;
            assign s_arprot[i*3 +: 3] = s_axi_if[i].arprot;
            assign s_arqos[i*4 +: 4] = s_axi_if[i].arqos;
            assign s_aruser[i*USER_WIDTH +: USER_WIDTH] = s_axi_if[i].aruser;
            assign s_arvalid[i] = s_axi_if[i].arvalid;
            assign s_axi_if[i].arready = s_arready[i];
            assign s_axi_if[i].rid = s_rid[i*S_ID_WIDTH +: S_ID_WIDTH];
            assign s_axi_if[i].rdata = s_rdata[i*DATA_WIDTH +: DATA_WIDTH];
            assign s_axi_if[i].rresp = s_rresp[i*2 +: 2];
            assign s_axi_if[i].rlast = s_rlast[i];
            assign s_axi_if[i].ruser = s_ruser[i*USER_WIDTH +: USER_WIDTH];
            assign s_axi_if[i].rvalid = s_rvalid[i];
            assign s_rready[i] = s_axi_if[i].rready;
        end

        for (i = 0; i < M_COUNT; i++) begin : pack_m
            assign m_axi_if[i].awid = m_awid[i*M_ID_WIDTH +: M_ID_WIDTH];
            assign m_axi_if[i].awaddr = m_awaddr[i*ADDR_WIDTH +: ADDR_WIDTH];
            assign m_axi_if[i].awlen = m_awlen[i*8 +: 8];
            assign m_axi_if[i].awsize = m_awsize[i*3 +: 3];
            assign m_axi_if[i].awburst = m_awburst[i*2 +: 2];
            assign m_axi_if[i].awlock = m_awlock[i];
            assign m_axi_if[i].awcache = m_awcache[i*4 +: 4];
            assign m_axi_if[i].awprot = m_awprot[i*3 +: 3];
            assign m_axi_if[i].awqos = m_awqos[i*4 +: 4];
            assign m_axi_if[i].awuser = m_awuser[i*USER_WIDTH +: USER_WIDTH];
            assign m_axi_if[i].awvalid = m_awvalid[i];
            assign m_awready[i] = m_axi_if[i].awready;
            assign m_axi_if[i].wdata = m_wdata[i*DATA_WIDTH +: DATA_WIDTH];
            assign m_axi_if[i].wstrb = m_wstrb[i*STRB_WIDTH +: STRB_WIDTH];
            assign m_axi_if[i].wlast = m_wlast[i];
            assign m_axi_if[i].wuser = m_wuser[i*USER_WIDTH +: USER_WIDTH];
            assign m_axi_if[i].wvalid = m_wvalid[i];
            assign m_wready[i] = m_axi_if[i].wready;
            assign m_bid[i*M_ID_WIDTH +: M_ID_WIDTH] = m_axi_if[i].bid;
            assign m_bresp[i*2 +: 2] = m_axi_if[i].bresp;
            assign m_buser[i*USER_WIDTH +: USER_WIDTH] = m_axi_if[i].buser;
            assign m_bvalid[i] = m_axi_if[i].bvalid;
            assign m_axi_if[i].bready = m_bready[i];
            assign m_axi_if[i].arid = m_arid[i*M_ID_WIDTH +: M_ID_WIDTH];
            assign m_axi_if[i].araddr = m_araddr[i*ADDR_WIDTH +: ADDR_WIDTH];
            assign m_axi_if[i].arlen = m_arlen[i*8 +: 8];
            assign m_axi_if[i].arsize = m_arsize[i*3 +: 3];
            assign m_axi_if[i].arburst = m_arburst[i*2 +: 2];
            assign m_axi_if[i].arlock = m_arlock[i];
            assign m_axi_if[i].arcache = m_arcache[i*4 +: 4];
            assign m_axi_if[i].arprot = m_arprot[i*3 +: 3];
            assign m_axi_if[i].arqos = m_arqos[i*4 +: 4];
            assign m_axi_if[i].aruser = m_aruser[i*USER_WIDTH +: USER_WIDTH];
            assign m_axi_if[i].arvalid = m_arvalid[i];
            assign m_arready[i] = m_axi_if[i].arready;
            assign m_rid[i*M_ID_WIDTH +: M_ID_WIDTH] = m_axi_if[i].rid;
            assign m_rdata[i*DATA_WIDTH +: DATA_WIDTH] = m_axi_if[i].rdata;
            assign m_rresp[i*2 +: 2] = m_axi_if[i].rresp;
            assign m_rlast[i] = m_axi_if[i].rlast;
            assign m_ruser[i*USER_WIDTH +: USER_WIDTH] = m_axi_if[i].ruser;
            assign m_rvalid[i] = m_axi_if[i].rvalid;
            assign m_axi_if[i].rready = m_rready[i];
        end
    endgenerate

    axi_crossbar #(
        .S_COUNT(S_COUNT),
        .M_COUNT(M_COUNT),
        .DATA_WIDTH(DATA_WIDTH),
        .ADDR_WIDTH(ADDR_WIDTH),
        .STRB_WIDTH(STRB_WIDTH),
        .S_ID_WIDTH(S_ID_WIDTH),
        .M_ID_WIDTH(M_ID_WIDTH),
        .AWUSER_ENABLE(0),
        .WUSER_ENABLE(0),
        .BUSER_ENABLE(0),
        .ARUSER_ENABLE(0),
        .RUSER_ENABLE(0),
        .M_REGIONS(1),
        .M_BASE_ADDR(M_BASE_ADDR),
        .M_ADDR_WIDTH(M_ADDR_WIDTH),
        .M_CONNECT_READ({M_COUNT{{S_COUNT{1'b1}}}}),
        .M_CONNECT_WRITE({M_COUNT{{S_COUNT{1'b1}}}})
    ) dut (
        .clk(clk),
        .rst(rst),
        .s_axi_awid(s_awid),
        .s_axi_awaddr(s_awaddr),
        .s_axi_awlen(s_awlen),
        .s_axi_awsize(s_awsize),
        .s_axi_awburst(s_awburst),
        .s_axi_awlock(s_awlock),
        .s_axi_awcache(s_awcache),
        .s_axi_awprot(s_awprot),
        .s_axi_awqos(s_awqos),
        .s_axi_awuser(s_awuser),
        .s_axi_awvalid(s_awvalid),
        .s_axi_awready(s_awready),
        .s_axi_wdata(s_wdata),
        .s_axi_wstrb(s_wstrb),
        .s_axi_wlast(s_wlast),
        .s_axi_wuser(s_wuser),
        .s_axi_wvalid(s_wvalid),
        .s_axi_wready(s_wready),
        .s_axi_bid(s_bid),
        .s_axi_bresp(s_bresp),
        .s_axi_buser(s_buser),
        .s_axi_bvalid(s_bvalid),
        .s_axi_bready(s_bready),
        .s_axi_arid(s_arid),
        .s_axi_araddr(s_araddr),
        .s_axi_arlen(s_arlen),
        .s_axi_arsize(s_arsize),
        .s_axi_arburst(s_arburst),
        .s_axi_arlock(s_arlock),
        .s_axi_arcache(s_arcache),
        .s_axi_arprot(s_arprot),
        .s_axi_arqos(s_arqos),
        .s_axi_aruser(s_aruser),
        .s_axi_arvalid(s_arvalid),
        .s_axi_arready(s_arready),
        .s_axi_rid(s_rid),
        .s_axi_rdata(s_rdata),
        .s_axi_rresp(s_rresp),
        .s_axi_rlast(s_rlast),
        .s_axi_ruser(s_ruser),
        .s_axi_rvalid(s_rvalid),
        .s_axi_rready(s_rready),
        .m_axi_awid(m_awid),
        .m_axi_awaddr(m_awaddr),
        .m_axi_awlen(m_awlen),
        .m_axi_awsize(m_awsize),
        .m_axi_awburst(m_awburst),
        .m_axi_awlock(m_awlock),
        .m_axi_awcache(m_awcache),
        .m_axi_awprot(m_awprot),
        .m_axi_awqos(m_awqos),
        .m_axi_awregion(m_awregion),
        .m_axi_awuser(m_awuser),
        .m_axi_awvalid(m_awvalid),
        .m_axi_awready(m_awready),
        .m_axi_wdata(m_wdata),
        .m_axi_wstrb(m_wstrb),
        .m_axi_wlast(m_wlast),
        .m_axi_wuser(m_wuser),
        .m_axi_wvalid(m_wvalid),
        .m_axi_wready(m_wready),
        .m_axi_bid(m_bid),
        .m_axi_bresp(m_bresp),
        .m_axi_buser(m_buser),
        .m_axi_bvalid(m_bvalid),
        .m_axi_bready(m_bready),
        .m_axi_arid(m_arid),
        .m_axi_araddr(m_araddr),
        .m_axi_arlen(m_arlen),
        .m_axi_arsize(m_arsize),
        .m_axi_arburst(m_arburst),
        .m_axi_arlock(m_arlock),
        .m_axi_arcache(m_arcache),
        .m_axi_arprot(m_arprot),
        .m_axi_arqos(m_arqos),
        .m_axi_arregion(m_arregion),
        .m_axi_aruser(m_aruser),
        .m_axi_arvalid(m_arvalid),
        .m_axi_arready(m_arready),
        .m_axi_rid(m_rid),
        .m_axi_rdata(m_rdata),
        .m_axi_rresp(m_rresp),
        .m_axi_rlast(m_rlast),
        .m_axi_ruser(m_ruser),
        .m_axi_rvalid(m_rvalid),
        .m_axi_rready(m_rready)
    );
endmodule
